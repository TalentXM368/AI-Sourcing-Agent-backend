generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication and Organizations ────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  email                String   @unique
  passwordHash         String   @map("password_hash")
  onboardingRole       String?  @map("onboarding_role")
  status               UserStatus @default(ACTIVE)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  lastLoginAt          DateTime? @map("last_login_at")

  memberships          OrganizationMember[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  createdInvitations   OrganizationInvitation[] @relation("InvitationCreator")

  @@index([status])
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  website     String?
  industry    String?
  companySize String?  @map("company_size")
  country     String?
  logoUrl     String?  @map("logo_url")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  candidates  Candidate[]
  jobs        Job[]
  clients     Client[]
  projects    Project[]
  searchHistory SearchHistory[]

  @@index([name])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  role           OrganizationMemberRole
  status         OrganizationMemberStatus @default(ACTIVE)
  joinedAt       DateTime?                @map("joined_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@map("organization_members")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model OrganizationInvitation {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  email          String
  role           OrganizationMemberRole
  tokenHash      String                   @unique @map("token_hash")
  expiresAt      DateTime                 @map("expires_at")
  acceptedAt     DateTime?                @map("accepted_at")
  createdById    String                   @map("created_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([email, expiresAt])
  @@map("organization_invitations")
}

// ─── Candidates ───────────────────────────────────────────────

model Candidate {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  name             String
  email            String?
  phone            String?
  linkedinUrl      String?   @map("linkedin_url")
  githubUrl        String?   @map("github_url")
  portfolioUrl     String?   @map("portfolio_url")
  headline         String?
  location         String?
  summary          String?
  experienceYears  Float?    @map("experience_years")
  skills           Json      @default("[]")
  companies        Json      @default("[]")
  workHistory      Json      @default("[]") @map("work_history")
  education        Json      @default("[]")
  projects         Json      @default("[]")
  certifications   Json      @default("[]")
  languages        Json      @default("[]")
  resumeUrl        String?   @map("resume_url")
  rawText          String?   @map("raw_text")
  sourceFile       String?   @map("source_file")
  parseStatus      String    @default("pending") @map("parse_status")
  parseError       String?   @map("parse_error")
  dataQualityScore Int?      @map("data_quality_score")
  missingFields    String[]  @default([]) @map("missing_fields")
  stage            String    @default("new")
  industry         String?
  region           String?
  pdlId            String?   @unique @map("pdl_id")
  soId             String?   @unique @map("so_id")
  coresignalId     String?   @unique @map("coresignal_id")
  source           String    @default("resume")
  stageUpdatedAt   DateTime? @map("stage_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  embeddings        Embedding[]
  rankedCandidates  RankedCandidate[]
  aiEvaluations     AiEvaluation[]
  projectCandidates ProjectCandidate[]
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([sourceFile])
  @@map("candidates")
}

// ─── Jobs ─────────────────────────────────────────────────────

model Job {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  createdById      String?  @map("created_by_id") @db.Uuid
  clientId         String?  @map("client_id") @db.Uuid
  role             String
  company          String?
  location         String?
  requiredSkills   String[] @default([]) @map("required_skills")
  niceToHaveSkills String[] @default([]) @map("nice_to_have_skills")
  avoidSkills      String[] @default([]) @map("avoid_skills")
  experienceMin    Int?     @map("experience_min")
  experienceMax    Int?     @map("experience_max")
  description      String?
  rawText          String?  @map("raw_text")
  industry         String?
  region           String?
  status           String   @default("open")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  embeddings       Embedding[]
  rankedCandidates RankedCandidate[]
  aiEvaluations    AiEvaluation[]
  projects         Project[]
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("jobs")
}

// ─── Clients ──────────────────────────────────────────────────

model Client {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid
  createdById        String?  @map("created_by_id") @db.Uuid
  zohoAccountId      String?  @unique @map("zoho_account_id")
  accountName        String   @map("account_name")
  industry           String?
  location           String?
  status             String   @default("active")
  urgency            String   @default("medium")
  openRoles          Int      @default(0) @map("open_roles")
  placementsYtd      Int      @default(0) @map("placements_ytd")
  hiringPreferences  Json     @default("{}") @map("hiring_preferences")
  culture            Json     @default("{}")
  roleContext        Json     @default("{}") @map("role_context")
  historicalPatterns Json     @default("{}") @map("historical_patterns")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  jobs     Job[]
  projects Project[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("clients")
}

// ─── Embeddings ───────────────────────────────────────────────

model Embedding {
  id         String                 @id @default(uuid()) @db.Uuid
  entityType String                 @map("entity_type")
  entityId   String                 @map("entity_id") @db.Uuid
  purpose    String
  vector     Unsupported("float[]")
  model      String                 @default("text-embedding-3-small")
  createdAt  DateTime               @default(now()) @map("created_at")

  candidate Candidate? @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "embeddings_candidate_id_fkey")
  job       Job?       @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "embeddings_job_id_fkey")

  @@unique([entityType, entityId, purpose])
  @@index([entityType, entityId])
  @@map("embeddings")
}

// ─── Ranked Candidates ────────────────────────────────────────

model RankedCandidate {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  semanticScore   Float    @default(0) @map("semantic_score")
  skillScore      Float    @default(0) @map("skill_score")
  experienceScore Float    @default(0) @map("experience_score")
  educationScore  Float    @default(0) @map("education_score")
  clientFitScore  Float    @default(0) @map("client_fit_score")
  totalScore      Float    @default(0) @map("total_score")
  exactMatches    String[] @default([]) @map("exact_matches")
  semanticMatches String[] @default([]) @map("semantic_matches")
  missingSkills   String[] @default([]) @map("missing_skills")
  avoidSignals    String[] @default([]) @map("avoid_signals")
  explanation     String?
  llmScore        Float    @default(0) @map("llm_score")
  llmVerdict      String?  @map("llm_verdict")
  llmReasoning    String?  @map("llm_reasoning")
  atsScore        Int?     @map("ats_score")
  decision        String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId, totalScore(sort: Desc)])
  @@index([jobId, decision])
  @@map("ranked_candidates")
}

// ─── AI Evaluations (Phase 6 → Phase 7 integration) ──────────

model AiEvaluation {
  id            String   @id @default(uuid()) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  matchScore    Float    @default(0) @map("match_score")
  displayScore  Float    @default(0) @map("display_score")
  confidence    Json     @default("{}")
  cardSummary   String?  @map("card_summary")
  detailSummary String?  @map("detail_summary")
  reasoning     Json?
  rerankerScore Float?   @map("reranker_score")
  provider      String?
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@map("ai_evaluations")
}

// ─── Pipeline Runs (audit log) ────────────────────────────────

model PipelineRun {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  entityId    String?   @map("entity_id") @db.Uuid
  status      String    @default("queued")
  progress    Int       @default(0)
  result      Json?
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([type, status])
  @@index([entityId])
  @@map("pipeline_runs")
}

// ─── Processing Status (real-time stage tracking) ─────────────

model ProcessingStatus {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  stage      String
  status     String   @default("pending")
  progress   Int      @default(0)
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, stage])
  @@map("processing_status")
}

// ─── Settings (key-value config) ──────────────────────────────

model Setting {
  key       String   @id
  value     Json     @default("true")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

// ─── Projects (LinkedIn Recruiter-style pipelines) ────────────

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  jobId       String?  @map("job_id") @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectCandidates  ProjectCandidate[]
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("projects")
}

model ProjectCandidate {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  stage         String   @default("new")
  addedFrom     String?  @map("added_from")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([projectId, candidateId])
  @@index([projectId])
  @@index([candidateId])
  @@index([projectId, stage])
  @@map("project_candidates")
}

// ─── Search History ───────────────────────────────────────────

model SearchHistory {
  id           String   @id @default(uuid()) @db.Uuid
  source       String
  query        String
  filters      Json?
  resultCount  Int      @default(0) @map("result_count")
  savedCount   Int      @default(0) @map("saved_count")
  candidateIds String[] @default([]) @map("candidate_ids")
  organizationId String? @map("organization_id") @db.Uuid
  createdById   String? @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([createdAt(sort: Desc)])
  @@map("search_history")
}
